  "description": "O-RAN 3GPP Knowledge Graph with GNN, ADR, and DDD - Powered by RuVector, Claude Flow, and Agentic Flow",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "download": "node download-dataset.js",
    "load": "node load-to-postgres.js",
    "setup": "node index.js",
    "query": "node query-examples.js",
    "advanced": "node advanced-examples.js",
    "install-ruvector": "npx @ruvector/postgres-cli install",
    "gnn:create": "npx @ruvector/gnn create",
    "gnn:train": "npx @ruvector/gnn train",
    "gnn:infer": "npx @ruvector/gnn infer",
    "flow:start": "npx claude-flow start",
    "agentic:run": "npx agentic-flow run",
    "docs:adr": "echo 'ADR docs available in docs/adr/'",
    "docs:ddd": "echo 'DDD docs available in docs/ddd/'",
    "test": "echo \"Error: no test specified\" && exit 1"
