# PostgreSQL / RuVector Configuration
# Default values for RuVector installation (installed via: npm run install-ruvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ruvector
POSTGRES_USER=ruvector
POSTGRES_PASSWORD=ruvector

# For custom PostgreSQL installations, update the values above
# Example for standard PostgreSQL:
# POSTGRES_DB=3gpp_knowledge_graph
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password_here

# Hugging Face Configuration (optional, for private datasets)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ===== Multi-Agent RAG with DSPy Configuration =====

# API Keys for LLMs
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Model Configuration (Two-Model Architecture)
STUDENT_MODEL=gpt-4o-mini
REFLECTION_MODEL=gpt-4o
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Database Configuration
VECTOR_DB_PATH=./data/embeddings/faiss_index
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# MLflow Configuration
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=multi_agent_rag_dspy

# GEPA Optimizer Settings
GEPA_NUM_ITERATIONS=10
GEPA_POPULATION_SIZE=20
GEPA_PARETO_FRONTIER_SIZE=5
ENABLE_TOOL_OPTIMIZATION=true

# Meta-Cognitive Reasoning Configuration
META_COGNITIVE_CONFIDENCE_THRESHOLD=0.8
MAX_RETRY_ATTEMPTS=3

# Domain-Specific Subagent Configuration
SUBAGENT_DOMAINS=diabetes,copd,cardiology
